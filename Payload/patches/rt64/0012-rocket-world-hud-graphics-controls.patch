diff --git a/src/common/rt64_rocket_configuration.h b/src/common/rt64_rocket_configuration.h
new file mode 100644
--- /dev/null
+++ b/src/common/rt64_rocket_configuration.h
@@ -0,0 +1,123 @@
+//
+// Rocket-R project-owned RT64 presentation controls.
+//
+
+#pragma once
+
+#include <algorithm>
+#include <atomic>
+#include <cstdint>
+#include <mutex>
+#include <string>
+
+namespace RT64 {
+    struct RocketGraphicsControls {
+        std::atomic<float> fogDistanceMultiplier{1.0f};
+        std::atomic<float> zFightToleranceScale{1.0f};
+        std::atomic<uint32_t> viFilterMode{0U};
+        std::atomic<float> debandStrength{0.0f};
+        std::atomic<uint32_t> postProcessMode{0U};
+        std::atomic<float> postProcessStrength{0.70f};
+        std::atomic<uint32_t> hudAspectMode{0U};
+        std::atomic<float> hudScale{1.0f};
+        std::atomic<float> hudSafeMargin{0.0f};
+        std::mutex customShaderMutex;
+        std::string customShaderBasePath;
+    };
+
+    inline RocketGraphicsControls &rocketGraphicsControls() {
+        static RocketGraphicsControls controls;
+        return controls;
+    }
+
+    inline void setRocketFogDistanceMultiplier(float value) {
+        rocketGraphicsControls().fogDistanceMultiplier.store(
+            std::clamp(value, 0.0f, 8.0f), std::memory_order_release);
+    }
+
+    inline float getRocketFogDistanceMultiplier() {
+        return rocketGraphicsControls().fogDistanceMultiplier.load(
+            std::memory_order_acquire);
+    }
+
+    inline void setRocketZFightToleranceScale(float value) {
+        rocketGraphicsControls().zFightToleranceScale.store(
+            std::clamp(value, 1.0f, 4.0f), std::memory_order_release);
+    }
+
+    inline float getRocketZFightToleranceScale() {
+        return rocketGraphicsControls().zFightToleranceScale.load(
+            std::memory_order_acquire);
+    }
+
+    inline void setRocketViFilterMode(uint32_t value) {
+        rocketGraphicsControls().viFilterMode.store(
+            std::min(value, 1U), std::memory_order_release);
+    }
+
+    inline uint32_t getRocketViFilterMode() {
+        return rocketGraphicsControls().viFilterMode.load(
+            std::memory_order_acquire);
+    }
+
+    inline void setRocketDebandStrength(float value) {
+        rocketGraphicsControls().debandStrength.store(
+            std::clamp(value, 0.0f, 1.0f), std::memory_order_release);
+    }
+
+    inline float getRocketDebandStrength() {
+        return rocketGraphicsControls().debandStrength.load(
+            std::memory_order_acquire);
+    }
+
+    inline void setRocketPostProcess(uint32_t mode, float strength) {
+        rocketGraphicsControls().postProcessMode.store(
+            std::min(mode, 3U), std::memory_order_release);
+        rocketGraphicsControls().postProcessStrength.store(
+            std::clamp(strength, 0.0f, 1.0f), std::memory_order_release);
+    }
+
+    inline uint32_t getRocketPostProcessMode() {
+        return rocketGraphicsControls().postProcessMode.load(
+            std::memory_order_acquire);
+    }
+
+    inline float getRocketPostProcessStrength() {
+        return rocketGraphicsControls().postProcessStrength.load(
+            std::memory_order_acquire);
+    }
+
+    inline void setRocketHudConfiguration(uint32_t aspectMode, float scale,
+                                           float safeMargin) {
+        rocketGraphicsControls().hudAspectMode.store(
+            std::min(aspectMode, 2U), std::memory_order_release);
+        rocketGraphicsControls().hudScale.store(
+            std::clamp(scale, 0.5f, 1.5f), std::memory_order_release);
+        rocketGraphicsControls().hudSafeMargin.store(
+            std::clamp(safeMargin, 0.0f, 0.20f), std::memory_order_release);
+    }
+
+    inline uint32_t getRocketHudAspectMode() {
+        return rocketGraphicsControls().hudAspectMode.load(std::memory_order_acquire);
+    }
+
+    inline float getRocketHudScale() {
+        return rocketGraphicsControls().hudScale.load(std::memory_order_acquire);
+    }
+
+    inline float getRocketHudSafeMargin() {
+        return rocketGraphicsControls().hudSafeMargin.load(std::memory_order_acquire);
+    }
+
+    inline void setRocketCustomShaderBasePath(const std::string &path) {
+        auto &controls = rocketGraphicsControls();
+        const std::scoped_lock lock(controls.customShaderMutex);
+        controls.customShaderBasePath = path;
+    }
+
+    inline std::string getRocketCustomShaderBasePath() {
+        auto &controls = rocketGraphicsControls();
+        const std::scoped_lock lock(controls.customShaderMutex);
+        return controls.customShaderBasePath;
+    }
+}
