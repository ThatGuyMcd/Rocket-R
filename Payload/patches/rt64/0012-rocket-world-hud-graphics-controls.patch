@@ -1176,8 +1177,20 @@ namespace RT64 {
     }
 
     void RSP::setFog(int16_t mul, int16_t offset) {
-        fog.mul = mul;
-        fog.offset = offset;
+        const float distanceMultiplier = getRocketFogDistanceMultiplier();
+        if (distanceMultiplier <= 0.0001f) {
+            // A zero fog vector produces zero fog alpha in RSPProcessCS while
+            // preserving the guest's geometry mode and all other RDP state.
+            fog.mul = 0.0f;
+            fog.offset = 0.0f;
+        }
+        else {
+            // Fog alpha is z * mul + offset. Evaluating the authored response
+            // at z / multiplier moves the same fog curve farther from camera
+            // without guessing the original gSPFogPosition min/max pair.
+            fog.mul = static_cast<float>(mul) / distanceMultiplier;
+            fog.offset = offset;
+        }
         fogChanged = true;
     }
     
