             videoInterfacePixel.pipeline = device->createGraphicsPipeline(pipelineDesc);
+
+            // Rocket-R supports an optional precompiled final VI pixel shader.
+            // It deliberately uses RT64's existing fullscreen vertex shader,
+            // descriptor bindings and push-constant layout; no runtime source
+            // compiler is required on Linux/Android. The launcher supplies a
+            // base path and RT64 selects DXIL or SPIR-V for the active backend.
+            videoInterfaceCustomValid = false;
+            const std::string customBase = getRocketCustomShaderBasePath();
+            const char *customExtension = nullptr;
+            if (shaderFormat == RenderShaderFormat::DXIL) {
+                customExtension = ".dxil";
+            }
+            else if (shaderFormat == RenderShaderFormat::SPIRV) {
+                customExtension = ".spv";
+            }
+
+            if (!customBase.empty() && (customExtension != nullptr)) {
+                const std::filesystem::path customPath =
+                    std::filesystem::u8path(customBase + customExtension);
+                std::ifstream input(customPath, std::ios::binary | std::ios::ate);
+                if (input) {
+                    const std::streamsize byteCount = input.tellg();
+                    if (byteCount > 0) {
+                        std::vector<uint8_t> bytes(static_cast<size_t>(byteCount));
+                        input.seekg(0, std::ios::beg);
+                        if (input.read(reinterpret_cast<char *>(bytes.data()), byteCount)) {
+                            try {
+                                std::unique_ptr<RenderShader> customShader =
+                                    device->createShader(bytes.data(), bytes.size(),
+                                                         "PSMain", shaderFormat);
+                                if (customShader != nullptr) {
+                                    VideoInterfaceDescriptorSet customDescriptorSet(
+                                        samplerLibrary.linear.borderBorder.get());
+                                    layoutBuilder.begin();
+                                    layoutBuilder.addPushConstant(
+                                        0, 0, sizeof(interop::VideoInterfaceCB),
+                                        RenderShaderStageFlag::PIXEL);
+                                    layoutBuilder.addDescriptorSet(customDescriptorSet);
+                                    layoutBuilder.end();
+                                    videoInterfaceCustom.pipelineLayout =
+                                        layoutBuilder.create(device);
+
+                                    pipelineDesc.pixelShader = customShader.get();
+                                    pipelineDesc.pipelineLayout =
+                                        videoInterfaceCustom.pipelineLayout.get();
+                                    videoInterfaceCustom.pipeline =
+                                        device->createGraphicsPipeline(pipelineDesc);
+                                    videoInterfaceCustomValid =
+                                        videoInterfaceCustom.pipeline != nullptr;
+                                }
+                            }
+                            catch (const std::exception &e) {
+                                RT64_LOG_PRINTF("Rocket-R custom VI shader failed: %s\n", e.what());
+                            }
+                        }
+                    }
+                }
+                if (!videoInterfaceCustomValid) {
+                    RT64_LOG_PRINTF("Rocket-R custom VI shader unavailable: %s\n",
+                                    customPath.string().c_str());
+                }
+            }
         }
     }
 
