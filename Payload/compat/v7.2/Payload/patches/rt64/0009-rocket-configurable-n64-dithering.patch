diff --git a/src/hle/rt64_state.cpp b/src/hle/rt64_state.cpp
--- a/src/hle/rt64_state.cpp
+++ b/src/hle/rt64_state.cpp
@@ -159,5 +159,15 @@ namespace RT64 {
 
         if (drawStatus.isChanged(DrawAttribute::OtherMode)) {
             drawCall.otherMode = rdp->otherMode;
+            if (!extended.n64DitheringEnabled) {
+                // Rocket enables G_CD_BAYER as part of its normal frame setup.
+                // Preserve the guest RDP state internally, but present decoded
+                // draw calls with RGB/alpha dithering disabled when the host
+                // launcher requests a cleaner modern image.
+                constexpr uint32_t DitherMask =
+                    (3U << G_MDSFT_ALPHADITHER) | (3U << G_MDSFT_RGBDITHER);
+                drawCall.otherMode.H = (drawCall.otherMode.H & ~DitherMask) |
+                    G_AD_DISABLE | G_CD_DISABLE;
+            }
             textureCheck = true;
         }
@@ -2778,6 +2788,15 @@ namespace RT64 {
     void State::setDitherNoiseStrength(float noiseStrength) {
         extended.ditherNoiseStrength = noiseStrength;
     }
+
+    void State::setN64DitheringEnabled(bool enabled) {
+        if (extended.n64DitheringEnabled != enabled) {
+            extended.n64DitheringEnabled = enabled;
+            // Force the next draw to rebuild OtherMode even if the guest has
+            // not emitted a different G_SETOTHERMODE command since the toggle.
+            updateDrawStatusAttribute(DrawAttribute::OtherMode);
+        }
+    }
     
     void State::setExtendedRDRAM(bool isExtended) {
         extended.extendRDRAM = isExtended;
