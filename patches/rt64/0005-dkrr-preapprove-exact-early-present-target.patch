+        const bool presentEarly = !ext.presentQueue->viewRDRAM && (ext.enhancementConfig->presentation.mode == EnhancementConfiguration::Presentation::Mode::PresentEarly);
+        workload.earlyPresentApproved = false;
+        workload.earlyPresentColorAddress = 0;
+        if (presentEarly && (workload.fbPairCount > 0)) {
+            thread_local std::unordered_set<uint32_t> approvalColorImageAddressSet;
+            approvalColorImageAddressSet.clear();
+
+            for (int32_t f = workload.fbPairCount - 1; (f >= 0) && !workload.earlyPresentApproved; f--) {
+                const FramebufferPair &fbPair = workload.fbPairs[f];
+                const auto &colorImg = fbPair.colorImage;
+                if (approvalColorImageAddressSet.find(colorImg.address) != approvalColorImageAddressSet.end()) {
+                    continue;
+                }
+                else {
+                    approvalColorImageAddressSet.insert(colorImg.address);
+                }
+
+                if (!fbPair.earlyPresentCandidate()) {
+                    continue;
+                }
+
+                for (size_t h = 0; (h < viHistory.history.size()) && !workload.earlyPresentApproved; h++) {
