@@ -0,0 +1,41 @@
+#pragma once
+
+#include <cmath>
+#include <cstdint>
+#include <vector>
+
+namespace RT64 {
+    struct RocketSkyTopology {
+        uint64_t hash = 14695981039346656037ULL;
+        uint32_t triangles = 0;
+        bool valid = true;
+    };
+
+    // Compare connectivity relative to a transform, not positions or arena slots.
+    // Cross-transform triangles cannot prove vertex correspondence and snap.
+    inline RocketSkyTopology rocketSkyTopology(const std::vector<uint32_t> &indices,
+                                               uint32_t first, uint32_t count) {
+        RocketSkyTopology result;
+        result.valid = count > 0 && (indices.size() % 3) == 0;
+        for (size_t i = 0; result.valid && i + 2 < indices.size(); i += 3) {
+            unsigned inside = 0;
+            for (unsigned j = 0; j < 3; ++j) {
+                inside += indices[i+j] >= first && uint64_t(indices[i+j]) < uint64_t(first) + count;
+            }
+            if (inside == 0) continue;
+            if (inside != 3) { result.valid = false; break; }
+            ++result.triangles;
+            for (unsigned j = 0; j < 3; ++j) {
+                result.hash = (result.hash ^ (indices[i+j] - first)) * 1099511628211ULL;
+            }
+        }
+        result.valid = result.valid && result.triangles > 0;
+        return result;
+    }
+
+    inline float rocketSkyWrappedDelta(float now, float before, float period) {
+        float delta = now - before;
+        if (period > 0 && std::isfinite(period)) delta -= std::round(delta / period) * period;
+        return delta;
+    }
+}
