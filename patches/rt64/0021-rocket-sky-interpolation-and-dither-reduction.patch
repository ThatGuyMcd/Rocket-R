+// A fixed texture-space filter: no frame history, random taps or framebuffer blur.
+float4 sampleRocketSkyTexture(OtherMode otherMode, RenderFlags flags, float2 uv,
+    float2 dx, float2 dy, RDPTile tile, GPUTile gpuTile, bool nextPixelBug,
+    float mipBias, float detail, float reduction) {
+    float4 center = sampleTexture(otherMode, flags, uv, dx, dy, tile, gpuTile, nextPixelBug, mipBias, detail);
+    [branch]
+    if (reduction <= 0.0f || gpuTileFlagHighRes(gpuTile.flags) || gpuTileFlagAlphaIsCvg(gpuTile.flags)) return center;
+
+    // Four bilinear taps cover the original 4x4 dither neighbourhood. Offsets
+    // are native texels, so output resolution/FOV cannot change the strength.
+    float correction = (otherMode.textPersp() == G_TP_PERSP || renderFlagRect(flags)) ? 1.0f : 0.5f;
+    float2 stepUV = 1.0f / max(abs(float2(tile.shifts, tile.shiftt) * correction), 0.0001f);
+    OtherMode filteredMode = otherMode;
+    filteredMode.H = (filteredMode.H & ~(3U << G_MDSFT_TEXTFILT)) | G_TF_BILERP;
+    RenderFlags filteredFlags = flags | (1U << 4); // true bilinear only for the smoothing taps
+    float3 sum = float3(0.0f, 0.0f, 0.0f);
+    float weightSum = 0.0f;
+    [unroll]
+    for (uint i = 0; i < 4; ++i) {
+        float2 offset = float2((i & 1) ? 1.0f : -1.0f, (i & 2) ? 1.0f : -1.0f);
+        float4 tap = sampleTexture(filteredMode, filteredFlags, uv + offset * stepUV,
+            dx, dy, tile, gpuTile, nextPixelBug, mipBias, detail);
+        float3 delta = abs(tap.rgb - center.rgb);
+        // Preserve stars/cloud edges and the source alpha. Small quantisation
+        // steps get full weight; large colour changes do not bleed into them.
+        float difference = max(delta.r, max(delta.g, delta.b));
+        float weight = 1.0f - smoothstep(0.055f, 0.12f, difference);
+        weight *= 1.0f - smoothstep(0.02f, 0.10f, abs(tap.a - center.a));
+        sum += tap.rgb * weight;
+        weightSum += weight;
+    }
+    if (weightSum > 0.0001f) center.rgb = lerp(center.rgb, sum / weightSum, saturate(reduction));
+    return center;
+}
