+// CPU/GPU memory ranges and queue families shared by Vulkan resource creation.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace plume {
+    struct MappedMemoryRange {
+        uint64_t offset = 0;
+        uint64_t size = 0;
+    };
+
+    inline MappedMemoryRange mappedMemoryRange(uint64_t bufferSize, bool explicitRange,
+                                               uint64_t begin = 0, uint64_t end = 0) {
+        if (!explicitRange) return {0, bufferSize};
+        const uint64_t offset = std::min(begin, bufferSize);
+        const uint64_t limit = std::min(end, bufferSize);
+        return {offset, limit > offset ? limit - offset : 0};
+    }
+
+    struct ResourceQueueFamilies {
+        std::array<uint32_t, 3> indices{};
+        uint32_t count = 0;
+    };
+
+    inline ResourceQueueFamilies resourceQueueFamilies(const uint32_t (&families)[3]) {
+        ResourceQueueFamilies result;
+        for (uint32_t family : families) {
+            if (std::find(result.indices.begin(), result.indices.begin() + result.count, family)
+                    == result.indices.begin() + result.count) {
+                result.indices[result.count++] = family;
+            }
+        }
+        return result;
+    }
+}
