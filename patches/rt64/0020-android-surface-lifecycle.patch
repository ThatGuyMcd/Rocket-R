     bool VulkanSwapChain::resize() {
+#if defined(__ANDROID__)
+        // Serialize with publication, then retire all uses of the old native
+        // surface before releasing it. This only runs on lifecycle changes.
+        std::unique_lock<std::mutex> windowLock(androidWindowMutex);
+        if (plume::androidWindowRevision != 0) {
+            if (androidWindow == nullptr) return false;
+            if (androidWindowRevision != plume::androidWindowRevision || surface == VK_NULL_HANDLE) {
+                if (vkDeviceWaitIdle(commandQueue->device->vk) != VK_SUCCESS) return false;
+                releaseImageViews();
+                releaseSwapChain();
+                auto *renderInterface = commandQueue->device->renderInterface;
+                if (surface != VK_NULL_HANDLE) {
+                    vkDestroySurfaceKHR(renderInterface->instance, surface, nullptr);
+                    surface = VK_NULL_HANDLE;
+                }
+                ANativeWindow_acquire(androidWindow);
+                ANativeWindow_release(desc.renderWindow);
+                desc.renderWindow = androidWindow;
+                androidWindowRevision = plume::androidWindowRevision;
+                VkAndroidSurfaceCreateInfoKHR surfaceInfo{};
+                surfaceInfo.sType = VK_STRUCTURE_TYPE_ANDROID_SURFACE_CREATE_INFO_KHR;
+                surfaceInfo.window = desc.renderWindow;
+                if (vkCreateAndroidSurfaceKHR(renderInterface->instance, &surfaceInfo, nullptr, &surface) != VK_SUCCESS) {
+                    surface = VK_NULL_HANDLE;
+                    return false;
+                }
+                currentPresentId = 0;
+                fprintf(stderr, "[plume][android] native surface restored\n");
+            }
+        }
+        windowLock.unlock();
+#endif
         getWindowSize(width, height);
 
