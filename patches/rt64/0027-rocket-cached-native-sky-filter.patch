+// Filter Rocket's verified opaque eight-column CI8 sky at native resolution.
+// No screen-size work, frame history, guest-memory writes or GPU filter pass.
+#pragma once
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace RT64 {
+inline unsigned rocketSkyFilterLevel(float reduction) {
+    return std::isfinite(reduction) ? unsigned(std::lround(std::clamp(reduction, 0.0f, 1.0f) * 100.0f)) : 0;
+}
+
+inline std::vector<uint8_t> rocketFilterSkyCI8(const uint8_t *tmem, size_t bytes,
+        unsigned width, unsigned height, unsigned start, unsigned stride, unsigned level) {
+    if (!tmem || bytes < 4096 || width != 8 || height == 0 || height > 256 ||
+        start >= 2048 || stride < width || stride > 2048 || (stride & 7) != 0 || level > 100) return {};
+    std::vector<uint8_t> rgba(width * height * 4);
+    std::array<std::array<unsigned, 3>, 256> rowSums{};
+    for (unsigned y = 0; y < height; ++y) {
+        for (unsigned x = 0; x < width; ++x) {
+            // RDP TMEM swaps the two 32-bit words on odd rows. TLUT entries
+            // occupy eight bytes each, with the RGBA16 value in the first two.
+            const unsigned address = (start + y * stride + (x ^ ((y & 1) ? 4U : 0U))) & 2047;
+            const unsigned palette = 2048 + unsigned(tmem[address]) * 8;
+            const unsigned color = (unsigned(tmem[palette]) << 8) | tmem[palette + 1];
+            if ((color & 1) == 0) return {}; // Preserve non-gradient/transparent skies.
+            const unsigned pixel = (y * width + x) * 4;
+            for (unsigned c = 0; c < 3; ++c) {
+                const unsigned value = (((color >> (11 - 5 * c)) & 31) * 255 + 15) / 31;
+                rgba[pixel + c] = uint8_t(value);
+                rowSums[y][c] += value;
+            }
+            rgba[pixel + 3] = 255;
+        }
+    }
+    if (level == 0) return rgba;
+    // Four half-texel vertical taps become this five-row kernel. Averaging
+    // all eight columns removes horizontal dither independently of scroll phase.
+    constexpr unsigned weights[] = {1, 2, 2, 2, 1};
+    for (unsigned y = 0; y < height; ++y) {
+        std::array<unsigned, 3> sum{};
+        for (int offset = -2; offset <= 2; ++offset) {
+            const unsigned row = unsigned(std::clamp(int(y) + offset, 0, int(height) - 1));
+            for (unsigned c = 0; c < 3; ++c) sum[c] += rowSums[row][c] * weights[offset + 2];
+        }
+        for (unsigned x = 0; x < width; ++x) {
+            const unsigned pixel = (y * width + x) * 4;
+            for (unsigned c = 0; c < 3; ++c) {
+                // Keep precision until the final RGBA8 result; round once.
+                const unsigned value = rgba[pixel + c] * (100 - level) * 64 + sum[c] * level;
+                rgba[pixel + c] = uint8_t((value + 3200) / 6400);
+            }
+        }
+    }
+    return rgba;
+}
+}
