diff --git a/src/hle/rt64_rsp.cpp b/src/hle/rt64_rsp.cpp
--- a/src/hle/rt64_rsp.cpp
+++ b/src/hle/rt64_rsp.cpp
@@ -14,6 +14,20 @@
 #include "rt64_interpreter.h"
 #include "rt64_state.h"
 
+// Rocket-R's DKR-R-style presentation sidecar. The physical matrix address is
+// only a lookup key for the exact immutable task being decoded. It is never the
+// interpolation identity itself.
+struct RocketPresentationMatrixBinding {
+    uint32_t identity;
+    uint8_t interpolate_vertices;
+    uint8_t interpolate_texcoords;
+    uint8_t interpolate_tiles;
+    uint8_t reserved;
+};
+extern "C" bool rocket_presentation_matrix_binding(
+    uint32_t physical_matrix_address,
+    RocketPresentationMatrixBinding *out_binding);
+
 //#define LOG_SPECIAL_MATRIX_OPERATIONS
 
 namespace RT64 {
@@ -627,9 +641,52 @@ namespace RT64 {
 
         if (addWorldTransform) {
             uint32_t physicalAddress = modelMatrixPhysicalAddressStack[modelMatrixStackSize - 1];
+            uint32_t groupIndex = extended.curModelMatrixIdGroupIndex;
+            RocketPresentationMatrixBinding semantic{};
+            if (rocket_presentation_matrix_binding(physicalAddress, &semantic)) {
+                TransformGroup group = workload.drawData.transformGroups[groupIndex];
+                group.matrixId = semantic.identity;
+                group.ordering = G_EX_ORDER_LINEAR;
+
+                // A successful Rocket sidecar lookup is authoritative. ID 0 is
+                // G_EX_ID_IGNORE and deliberately disables RT64's anonymous
+                // fallback matcher for an ambiguous/conflicting matrix.
+                const bool interpolateTransform =
+                    (semantic.identity != G_EX_ID_IGNORE) &&
+                    (semantic.identity != G_EX_ID_AUTO);
+
+                // Match DKR-R's stable matrix policy: do not decompose Rocket's
+                // arbitrary N64 matrices as rigid bodies. Interpolate only the
+                // components that are safe for an accepted semantic identity.
+                group.decompose = false;
+                group.positionInterpolation = interpolateTransform
+                    ? G_EX_COMPONENT_INTERPOLATE : G_EX_COMPONENT_SKIP;
+                group.rotationInterpolation = interpolateTransform
+                    ? G_EX_COMPONENT_INTERPOLATE : G_EX_COMPONENT_SKIP;
+                group.scaleInterpolation = G_EX_COMPONENT_SKIP;
+                group.skewInterpolation = G_EX_COMPONENT_SKIP;
+                group.perspectiveInterpolation = interpolateTransform
+                    ? G_EX_COMPONENT_INTERPOLATE : G_EX_COMPONENT_SKIP;
+                group.vertexInterpolation =
+                    interpolateTransform && semantic.interpolate_vertices
+                    ? G_EX_COMPONENT_INTERPOLATE : G_EX_COMPONENT_SKIP;
+                group.texcoordInterpolation =
+                    interpolateTransform && semantic.interpolate_texcoords
+                    ? G_EX_COMPONENT_AUTO : G_EX_COMPONENT_SKIP;
+                group.tileInterpolation =
+                    interpolateTransform && semantic.interpolate_tiles
+                    ? G_EX_COMPONENT_AUTO : G_EX_COMPONENT_SKIP;
+
+                // Rocket's render-entry owner already disambiguates these
+                // matrices. Generic look-at matching can only reintroduce an
+                // unrelated repeated-material candidate.
+                group.lookAtInterpolation = G_EX_COMPONENT_SKIP;
+                groupIndex = uint32_t(workload.drawData.transformGroups.size());
+                workload.drawData.transformGroups.emplace_back(group);
+            }
             workload.physicalAddressTransformMap.emplace(physicalAddress, uint32_t(worldTransformGroups.size()));
-            worldTransformGroups.emplace_back(extended.curModelMatrixIdGroupIndex);
+            worldTransformGroups.emplace_back(groupIndex);
             worldTransformSegmentedAddresses.emplace_back(modelMatrixSegmentedAddressStack[modelMatrixStackSize - 1]);
             worldTransformPhysicalAddresses.emplace_back(physicalAddress);
             worldTransformVertexIndices.emplace_back(workload.drawData.vertexCount());
         }
diff --git a/src/hle/rt64_game_frame.h b/src/hle/rt64_game_frame.h
