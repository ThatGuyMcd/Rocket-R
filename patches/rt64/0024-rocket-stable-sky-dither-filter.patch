--- /dev/null
+++ b/src/shared/rt64_rocket_sky_filter.h
@@ -0,0 +1,11 @@
+#pragma once
+
+// A complete four-texel box at half-texel offsets. Its bilinear samples cancel
+// every phase of a repeating 4x4 pattern, including while scrolling vertically.
+#ifdef HLSL_CPU
+namespace RT64 {
+inline float rocketSkyFilterAxis(unsigned i) { return float(i) - 1.5f; }
+}
+#else
+float rocketSkyFilterAxis(uint i) { return float(i) - 1.5f; }
+#endif
