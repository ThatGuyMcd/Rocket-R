--- /dev/null
+++ b/src/tools/file_to_c/file_to_c.py
@@ -0,0 +1,51 @@
+#!/usr/bin/env python3
+from __future__ import annotations
+
+import pathlib
+import sys
+
+
+def main() -> int:
+    if len(sys.argv) != 5:
+        print(f"Usage: {sys.argv[0]} [input file] [array name] [output C file] [output C header]")
+        return 0
+    input_path = pathlib.Path(sys.argv[1])
+    array_name = sys.argv[2]
+    output_c = pathlib.Path(sys.argv[3])
+    output_h = pathlib.Path(sys.argv[4])
+    data = input_path.read_bytes()
+    if not data:
+        print(f"Failed to open file {input_path}! (Or it's empty)", file=sys.stderr)
+        return 1
+    output_c.parent.mkdir(parents=True, exist_ok=True)
+    output_h.parent.mkdir(parents=True, exist_ok=True)
+    # file_to_c.cpp writes the values through a signed char on the supported
+    # desktop hosts. Preserve that exact representation for generated shaders.
+    values = ", ".join(str(b if b < 128 else b - 256) for b in data) + ", "
+    output_c.write_text(
+        "#include <stddef.h>\n"
+        f"extern const char {array_name}[{len(data)}];\n"
+        f"const char {array_name}[{len(data)}] = {{{values}}};\n"
+        f"extern const size_t {array_name}_size;\n"
+        f"const size_t {array_name}_size = sizeof({array_name}) / sizeof({array_name}[0]);\n",
+        encoding="utf-8",
+        newline="\n",
+    )
+    output_h.write_text(
+        "#ifdef __cplusplus\n"
+        "  extern \"C\" {\n"
+        "#endif\n"
+        "#include <stddef.h>\n"
+        f"extern const char {array_name}[{len(data)}];\n"
+        f"extern const size_t {array_name}_size;\n"
+        "#ifdef __cplusplus\n"
+        "  }\n"
+        "#endif\n",
+        encoding="utf-8",
+        newline="\n",
+    )
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
