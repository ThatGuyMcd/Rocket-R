// ROCKET-R UI V36 WINDOWS APPLICATION ICON
#define IDI_ROCKET_R 101
IDI_ROCKET_R ICON "UI/Rocket-R-green.ico"

1 VERSIONINFO
 FILEVERSION ROCKET_R_VERSION_MAJOR,ROCKET_R_VERSION_MINOR,ROCKET_R_VERSION_PATCH,0
 PRODUCTVERSION ROCKET_R_VERSION_MAJOR,ROCKET_R_VERSION_MINOR,ROCKET_R_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ThatGuyMcd\0"
            VALUE "FileDescription", "Rocket: Robot on wheels Recompiled\0"
            VALUE "FileVersion", ROCKET_R_VERSION "\0"
            VALUE "InternalName", "Rocket-R\0"
            VALUE "OriginalFilename", "Rocket-R.exe\0"
            VALUE "ProductName", "Rocket-R\0"
            VALUE "ProductVersion", ROCKET_R_VERSION "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
